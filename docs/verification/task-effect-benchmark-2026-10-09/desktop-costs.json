        "file_path": "smoke-cmp.ps1",
        "content": "$ErrorActionPreference = 'Stop'\n\n$ownerUrl = 'http://127.0.0.1:3829/api/records-591a9d69?id=doc-c90537a007a5540024cf3c3865cf8b6f6c8f'\n$subjUrl  = 'http://127.0.0.1:3829/api/records-591a9d69?id=doc-c9425e57aa0099d8107bcf32554e47247a01'\n$ownerTok = 'Bearer 75bbbdee7a263eec0b0bc2e52e58fba8c493'\n$subjTok  = 'Bearer 704a417ef260d537e6113aa0894487d09a63'\n\n$client = New-Object System.Net.Http.HttpClient\n$client.Timeout = [TimeSpan]::FromSeconds(10)\n\nfunction Send-Req {\n    param([string]$name, [string]$url, [string]$auth)\n    $req = New-Object System.Net.Http.HttpRequestMessage([System.Net.Http.HttpMethod]::Get, $url)\n    if ($auth) { [void]$req.Headers.TryAddWithoutValidation('Authorization', $auth) }\n    $resp = $client.SendAsync($req).GetAwaiter().GetResult()\n    $body = $resp.Content.ReadAsStringAsync().GetAwaiter().GetResult()\n    $recv = @()\n    if ($resp.Headers.Contains('X-Benchmark-Receipt')) { $recv += $resp.Headers.GetValues('X-Benchmark-Receipt') }\n    if ($resp.Content.Headers.Contains('X-Benchmark-Receipt')) { $recv += $resp.Content.Headers.GetValues('X-Benchmark-Receipt') }\n    $o = [ordered]@{\n        name    = $name\n        url     = $url\n        auth    = $(if ($auth) { ($auth -replace '^Bearer (.{8}).*', 'Bearer $1...') } else { '<none>' })\n        status  = [int]$resp.StatusCode\n        receipt = ($recv -join '|')\n        body    = $body\n        bytes   = $body.Length\n    }\n    $resp.Dispose(); $req.Dispose()\n    return $o\n}\n\n$rows = @()\nforeach ($r in 1, 2) {\n    $rows += Send-Req \"r$r-owner-read-owner\"   $ownerUrl $ownerTok\n    $rows += Send-Req \"r$r-subject-read-own\"   $subjUrl  $subjTok\n    $rows += Send-Req \"r$r-subject-read-owner\" $ownerUrl $subjTok\n    $rows += Send-Req \"r$r-anon-read-owner\"    $ownerUrl $null\n}\n\n$rows | ConvertTo-Json -Depth 6 | Set-Content -Encoding UTF8 smoke-results.json\nWrite-Output \"rows=$($rows.Count)\"\n$rows | ForEach-Object { \"{0} status={1} bytes={2} receipt={3}\" -f $_.name, $_.status, $_.bytes, $_.receipt }\n"
      }
