# Normalize line endings across platforms
* text=auto

# Source & config: keep LF on checkout
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Windows-specific scripts keep CRLF
*.ps1 text eol=crlf

# Binaries
*.tgz binary
*.png binary
*.jpg binary
*.ico binary
