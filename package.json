{
  "name": "dsh-saker",
  "version": "0.6.3",
  "description": "Saker — 运行在 dsh Desktop 上的安全测试工作台，支持自由测试、比赛模式与案例测试。",
  "type": "module",
  "main": "./lib/preset-root.js",
  "exports": {
    ".": "./lib/preset-root.js",
    "./preset-root": "./lib/preset-root.js",
    "./skill-registry": "./lib/skill-registry.js",
    "./settings-compat": "./lib/settings-compat.js",
    "./working-directory": "./lib/working-directory.mjs",
    "./egress": "./lib/egress.js",
    "./asset-inventory": "./lib/asset-inventory.mjs",
    "./report-drafts": "./lib/report-drafts.mjs",
    "./pentest-policy": "./lib/pentest-policy.mjs",
    "./query-expression": "./lib/query-expression.mjs",
    "./verification-basis": "./lib/verification-basis.mjs",
    "./scene-context": "./lib/scene-context.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./tool-runtime": "./lib/tool-runtime.mjs"
  },
  "files": [
    "preset",
    "shared",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "author": "ITroyeSivan <ITroyeSivan@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ITroyeSivan/Saker.git"
  },
  "homepage": "https://github.com/ITroyeSivan/Saker",
  "bugs": {
    "url": "https://github.com/ITroyeSivan/Saker/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "pentest",
    "redteam",
    "security"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.5 || 0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "js-yaml": "^4.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
