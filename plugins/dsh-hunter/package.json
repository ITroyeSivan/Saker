{
  "name": "@dsh-external/dsh-hunter",
  "version": "1.5.4",
  "description": "DSH asset search: FOFA / Hunter / Quake, bounded batch queries, desktop vulnerability-source updates, and authorized live verification.",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "asset-hunting",
    "fofa",
    "hunter",
    "quake"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@dsh-external/dsh-knowledge-hub": "*",
    "@dsh-external/dsh-nday-hunter": "*",
    "@dsh-external/dsh-redteam-results": "*",
    "dsh-saker": "*"
  },
  "license": "MIT",
  "author": "Saker contributors",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
