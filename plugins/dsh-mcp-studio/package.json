{
  "name": "@dsh-external/dsh-mcp-studio",
  "version": "1.1.22",
  "description": "MCP server studio for DeepSeek Harness: live-mounted servers with real connection status, a per-server tool browser, JSON import, and a dashboard-grade settings page.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --import ./tests/stub-register.mjs --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-invariants": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-mcp-resources": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-mcp-client": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-scope": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-subprocess": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-timeout": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.1.6-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "mcp",
    "model-context-protocol",
    "cordis"
  ],
  "packageManager": "pnpm@10.32.1",
  "author": "Saker contributors",
  "publishConfig": {
    "access": "public"
  }
}
