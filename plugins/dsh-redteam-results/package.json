{
  "name": "@dsh-external/dsh-redteam-results",
  "version": "1.0.196",
  "description": "管理自由测试、按文档连续检查、执行证据、发现与交付。",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "findings-tracker",
    "session-scoped"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./store": "./lib/store.js",
    "./delivery": "./lib/delivery.js",
    "./checked": "./lib/checked.js",
    "./bundle": "./lib/bundle.js",
    "./task-context": "./lib/task-context.js",
    "./content-catalog": "./lib/content-catalog.js",
    "./task-modules": "./lib/task-modules.js",
    "./test-catalog": "./lib/test-catalog.js",
    "./prompt-templates": "./lib/prompt-templates.js",
    "./prompt-store": "./lib/prompt-store.js",
    "./materials-view": "./lib/materials-view.js",
    "./materials-import": "./lib/materials-import.js",
    "./execution-view": "./lib/execution-view.js",
    "./work-lease": "./lib/work-lease.js",
    "./task-archive": "./lib/task-archive.js",
    "./method-classification": "./lib/method-classification.js",
    "./execution-modules": "./lib/execution-modules.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "license": "MIT",
  "author": "Saker contributors",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.0-rc.2 || 0.2.1-rc.2"
  }
}
