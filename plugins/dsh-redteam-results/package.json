{
  "name": "@dsh-external/dsh-redteam-results",
  "version": "1.0.53",
  "description": "查看测试进展、漏洞记录和验证详情，导出报告与复现文件。",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "findings-tracker",
    "session-scoped"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./store": "./lib/store.js",
    "./delivery": "./lib/delivery.js",
    "./checked": "./lib/checked.js",
    "./bundle": "./lib/bundle.js",
    "./task-context": "./lib/task-context.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "license": "MIT",
  "author": "Saker contributors",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
