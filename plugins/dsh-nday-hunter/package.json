{
  "name": "@dsh-external/dsh-nday-hunter",
  "version": "1.5.9",
  "description": "DSH Nday hunter (preset-plane, pentest): turn the Nday corpus into action — catalog query, fleet-scale fingerprint screening against machine-checkable probes, honest verdicts (screening signal is never reported as a vulnerability), and a ledger that hands the shortlist to the public exploitation tools.",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "nday",
    "fingerprint",
    "model-tools"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./catalog": "./lib/catalog.js",
    "./metrics": "./lib/metrics.js",
    "./priority": "./lib/priority.js",
    "./source-pipeline": "./lib/source-pipeline.js",
    "./source-registry": "./lib/source-registry.js",
    "./source-subscriptions": "./lib/source-subscriptions.js",
    "./source-reviews": "./lib/source-reviews.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "dsh-saker": "*",
    "@dsh-external/dsh-redteam-results": "*"
  },
  "peerDependenciesMeta": {
    "@dsh-external/dsh-redteam-results": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "Saker contributors"
}
